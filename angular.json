{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ngx-esy-jsonapi": {
      "projectType": "library",
      "root": "projects/ngx-esy-jsonapi",
      "sourceRoot": "projects/ngx-esy-jsonapi/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "projects/ngx-esy-jsonapi/tsconfig.lib.json",
            "project": "projects/ngx-esy-jsonapi/ng-package.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "ngx-esy-jsonapi:build",
            "tsConfig": "projects/ngx-esy-jsonapi/tsconfig.spec.json",
            "setupFiles": [
              "projects/ngx-esy-jsonapi/test/setup.ts"
            ],
            "coverageReporters": ["lcov", "text-summary"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ngx-esy-jsonapi/**/*.ts",
              "projects/ngx-esy-jsonapi/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "schematicCollections": [
      "@angular-eslint/schematics"
    ],
    "analytics": false
  }
}
