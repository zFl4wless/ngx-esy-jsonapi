{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ngx-esy-jsonapi": {
      "projectType": "library",
      "root": "projects/ngx-esy-jsonapi",
      "sourceRoot": "projects/ngx-esy-jsonapi/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "projects/ngx-esy-jsonapi/tsconfig.lib.json",
            "project": "projects/ngx-esy-jsonapi/ng-package.json"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/ngx-esy-jsonapi/tsconfig.spec.json",
            "polyfills": [
              "reflect-metadata",
              "zone.js",
              "zone.js/testing"
            ],
            "karmaConfig": "projects/ngx-esy-jsonapi/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ngx-esy-jsonapi/**/*.ts",
              "projects/ngx-esy-jsonapi/**/*.html"
            ]
          }
        }
      }
    },
    "demo": {
      "projectType": "application",
      "root": "projects/demo",
      "sourceRoot": "projects/demo/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/demo",
            "browser": "projects/demo/src/main.ts",
            "index": "projects/demo/src/index.html",
            "tsConfig": "projects/demo/tsconfig.app.json",
            "styles": [
              "projects/demo/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "650kB",
                  "maximumError": "1MB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "demo:build:development"
            },
            "production": {
              "buildTarget": "demo:build:production"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/demo/tsconfig.spec.json",
            "polyfills": [
              "reflect-metadata",
              "zone.js",
              "zone.js/testing"
            ],
            "karmaConfig": "projects/ngx-esy-jsonapi/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/demo/**/*.ts",
              "projects/demo/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "schematicCollections": [
      "@angular-eslint/schematics"
    ],
    "analytics": false
  }
}
